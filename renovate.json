{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["/^versions\\.env$/"],
      "matchStrings": ["CAL_DIY_REF=(?<currentDigest>[a-f0-9]{40})"],
      "currentValueTemplate": "main",
      "depNameTemplate": "calcom/cal.diy",
      "packageNameTemplate": "https://github.com/calcom/cal.diy",
      "datasourceTemplate": "git-refs"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/^versions\\.env$/"],
      "matchStrings": ["NODE_IMAGE=(?<depName>node):(?<currentValue>[0-9.]+-bookworm)"],
      "datasourceTemplate": "docker",
      "versioningTemplate": "docker"
    }
  ],
  "packageRules": [
    {
      "description": "Stay on the Node 22 LTS line; a major bump needs a manual test",
      "matchDatasources": ["docker"],
      "matchPackageNames": ["node"],
      "allowedVersions": "<23"
    }
  ]
}
